#!/usr/bin/env bash
set -u

if [ -n "${FAKE_ARGV_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_ARGV_LOG"
fi

if [ "${1:-}" = "--version" ]; then
  echo "2026.10.26"
  exit 0
fi

url="${*: -1}"
probe=0
yes_playlist=0
for arg in "$@"; do
  [ "$arg" = "-J" ] && probe=1
  [ "$arg" = "--yes-playlist" ] && yes_playlist=1
done

if [ "$probe" = "1" ]; then
  sleep "${FAKE_PROBE_DELAY:-0}"
  # Mirror yt-dlp's routing: channels and playlists come back as listings, and a link
  # naming both a video and a playlist is the video unless --yes-playlist is given.
  case "$url" in
    *"/@"*) cat "${FAKE_YTDLP_CHANNEL_INFO:?FAKE_YTDLP_CHANNEL_INFO not set}" ;;
    *"watch?"*"list="* | *"youtu.be/"?*"list="*)
      if [ "$yes_playlist" = "1" ]; then
        cat "${FAKE_YTDLP_PLAYLIST_INFO:?FAKE_YTDLP_PLAYLIST_INFO not set}"
      else
        cat "${FAKE_YTDLP_INFO:?FAKE_YTDLP_INFO not set}"
      fi ;;
    *"list="*) cat "${FAKE_YTDLP_PLAYLIST_INFO:?FAKE_YTDLP_PLAYLIST_INFO not set}" ;;
    *) cat "${FAKE_YTDLP_INFO:?FAKE_YTDLP_INFO not set}" ;;
  esac
  exit 0
fi

outdir=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-P" ]; then outdir="$arg"; fi
  prev="$arg"
done
[ -z "$outdir" ] && outdir="."
file="$outdir/video.mp4"

echo "PROGRESS {\"status\":\"downloading\",\"downloaded_bytes\":1000,\"total_bytes\":2000,\"speed\":1234.0,\"eta\":1}"
echo "DEST $file"
sleep "${FAKE_DELAY:-0}"
if [ "${FAKE_NO_OUTPUT:-0}" != "1" ]; then
  printf 'fake-media-data' > "$file"
fi
if [ "${FAKE_EXIT:-0}" != "0" ]; then
  echo "ERROR: fake failure" >&2
  exit "${FAKE_EXIT}"
fi
echo "PROGRESS {\"status\":\"finished\",\"downloaded_bytes\":2000,\"total_bytes\":2000}"
echo "FINAL $file"
